# ---------------------------------------------------------------------------
# OurWay website — environment variables
# Copy to .env.local for local development. Never commit real values.
# On Vercel: Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Public URL of the site, no trailing slash (used for canonical URLs, hreflang,
# sitemap and Open Graph). On Vercel it falls back to the production domain.
NEXT_PUBLIC_SITE_URL=https://www.example.gr

# --- Supabase (database, admin login, image storage) ------------------------
# Supabase → Project Settings → API (or the "Connect" button).
# These two are PUBLIC by design (they are sent to the browser); Row Level
# Security in supabase/migrations decides what each visitor may read/write.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_…) or the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET — used only by the local setup scripts (npm run db:setup /
# npm run admin:grant), never by the website itself. Do NOT add it to Vercel.
# Supabase → Connect → "Session pooler" connection string (with your DB password).
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Contact form email (https://resend.com) --------------------------------
# Without both values the form shows an honest "not configured" error and
# nothing is sent.
RESEND_API_KEY=
CONTACT_EMAIL=

# Optional: verified sender, e.g. "OurWay <hello@your-domain.gr>".
# Defaults to Resend's shared test sender (onboarding@resend.dev).
# Booking / private-trip emails to CUSTOMERS need a verified domain here:
# Resend's shared sender only delivers to the Resend account owner.
CONTACT_FROM_EMAIL=

# Optional: inbox for new booking / private-trip request notifications.
# Defaults to CONTACT_EMAIL.
BOOKINGS_EMAIL=

# --- Admin password recovery -------------------------------------------------
# SECRET, server-only. Lets the server check whether an email belongs to an
# administrator before Supabase sends a reset link. Create it with
# `npm run admin:recovery-key` (after `npm run db:setup`) and add the same value
# to Vercel. Without it, /admin/forgot-password reports "not set up" and sends
# nothing. See README → "Admin password recovery".
ADMIN_RECOVERY_KEY=

# --- Form submission key -----------------------------------------------------
# SECRET, server-only. The database accepts booking and tailor-made requests
# only when the server sends this key, so nobody can bypass the website's spam
# checks by calling the database directly. Create it with
# `npm run submission-key` and add the same value to Vercel (Production).
# Without it (once migration 0005 is applied) public forms report "not available".
SUBMISSION_KEY=
