# ---------------------------------------------------------------------------
# OurWay website — environment variables
# Copy to .env.local for local development. Never commit real values.
# On Vercel: Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Public URL of the site, no trailing slash (used for canonical URLs, hreflang,
# sitemap and Open Graph). On Vercel it falls back to the production domain.
NEXT_PUBLIC_SITE_URL=https://www.example.gr

# Contact form email delivery (https://resend.com). Without both values the
# form shows an honest "not configured" error and nothing is sent.
RESEND_API_KEY=
CONTACT_EMAIL=

# Optional: verified sender, e.g. "OurWay <hello@your-domain.gr>".
# Defaults to Resend's shared test sender (onboarding@resend.dev).
CONTACT_FROM_EMAIL=

# Optional: set to "true" (e.g. on Preview deployments) to render draft
# experiences/destinations such as /el/activities/example-experience.
SHOW_DRAFT_CONTENT=
